# -----------------------------------------------------------------------------
# Docker Compose project settings
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=academix

# -----------------------------------------------------------------------------
# Host port mappings
# -----------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
PGADMIN_PORT=5050
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=academix
POSTGRES_USER=academix
POSTGRES_PASSWORD=academix
POSTGRES_VOLUME_NAME=academix_postgres_data

# -----------------------------------------------------------------------------
# API / Web integration
# -----------------------------------------------------------------------------
API_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_AUTH_LOGIN_PATH=auth/login
NEXT_PUBLIC_AUTH_LOGOUT_PATH=auth/logout
NEXT_PUBLIC_AUTH_REFRESH_PATH=auth/refresh
MINIO_ENDPOINT=minio
MINIO_INTERNAL_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=academix-center-assets
MINIO_PUBLIC_BASE_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# pgAdmin
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@academix.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_VOLUME_NAME=academix_pgadmin_data
MINIO_VOLUME_NAME=academix_minio_data

# -----------------------------------------------------------------------------
# Network names
# -----------------------------------------------------------------------------
PUBLIC_NETWORK_NAME=academix_public_network
PRIVATE_NETWORK_NAME=academix_private_network

# -----------------------------------------------------------------------------
# Logging (applies to every service in docker-compose.yml)
# -----------------------------------------------------------------------------
LOG_DRIVER=local
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
LOG_COMPRESS=true
