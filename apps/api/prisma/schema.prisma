// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SECRETARY
  TEACHER
  STUDENT
}

enum SchoolCycle {
  PRIMARY
  COLLEGE
  LYCEE
}

enum SchoolYear {
  FIRST_YEAR  @map("1ER")
  SECOND_YEAR @map("2EME")
  THIRD_YEAR  @map("3EME")
  FOURTH_YEAR @map("4EME")
  FIFTH_YEAR  @map("5EME")
  SIXTH_YEAR  @map("6EME")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum PaymentMethod {
  CASH
}

enum DeductionType {
  PERCENTAGE_OF_TOTAL
  PERCENTAGE_PER_STUDENT
  FIXED_PER_STUDENT
}

enum DeductionScope {
  GLOBAL
  PER_TEACHER
}

enum NotificationType {
  CLASS_REMINDER
  PAYMENT_CONFIRMATION
  SCHEDULE_ALERT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PermissionAction {
  MANAGE_USERS
  MANAGE_SCHEDULE
  MANAGE_PAYMENTS
  MANAGE_ROOMS
  MANAGE_SUBJECTS
  MANAGE_GROUPS
  VIEW_REPORTS
  MANAGE_COSTS
  MANAGE_EXPENSES
  SEND_NOTIFICATIONS
}

model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique(map: "super_admins_email_key") @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phone        String   @db.VarChar(32)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  centers      Center[]

  @@index([isActive], map: "super_admins_is_active_idx")
  @@map("super_admins")
}

model Center {
  id              String           @id @default(uuid()) @db.Uuid
  superAdminId    String           @map("super_admin_id") @db.Uuid
  firstName       String           @map("first_name") @db.VarChar(100)
  lastName        String           @map("last_name") @db.VarChar(100)
  centerName      String           @map("center_name") @db.VarChar(140)
  email           String           @unique(map: "centers_email_key") @db.VarChar(320)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  phone           String           @db.VarChar(32)
  subdomain       String           @unique(map: "centers_subdomain_key") @db.VarChar(63)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  superAdmin      SuperAdmin       @relation(fields: [superAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "centers_super_admin_id_fkey")
  rooms           Room[]
  courseSessions  CourseSession[]
  payments        Payment[]
  centerCosts     CenterCost[]
  centerExpenses  CenterExpense[]
  rolePermissions RolePermission[]
  notifications   Notification[]
  subjects        Subject[]
  studentGroups   StudentGroup[]
  users           User[]

  @@index([superAdminId], map: "centers_super_admin_id_idx")
  @@index([isActive], map: "centers_is_active_idx")
  @@map("centers")
}

model User {
  id                    String           @id @default(uuid()) @db.Uuid
  centerId              String           @map("center_id") @db.Uuid
  firstName             String           @map("first_name") @db.VarChar(100)
  lastName              String           @map("last_name") @db.VarChar(100)
  email                 String           @db.VarChar(320)
  passwordHash          String           @map("password_hash") @db.VarChar(255)
  phone                 String           @db.VarChar(32)
  role                  UserRole
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  cin                   String?          @db.VarChar(32)
  parentPhone           String?          @map("parent_phone") @db.VarChar(32)
  schoolName            String?          @map("school_name") @db.VarChar(140)
  schoolCycle           SchoolCycle?     @map("school_cycle")
  schoolYear            SchoolYear?      @map("school_year")
  hourlyRate            Decimal?         @map("hourly_rate") @db.Decimal(10, 2)
  maxHoursPerWeek       Decimal?         @map("max_hours_per_week") @db.Decimal(5, 2)
  center                Center           @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "users_center_id_fkey")
  studentSessions       CourseSession[]  @relation("StudentSessions")
  teachingSessions      CourseSession[]  @relation("TeacherSessions")
  studentPayments       Payment[]        @relation("StudentPayments")
  teacherPayments       Payment[]        @relation("TeacherPayments")
  teacherCosts          CenterCost[]     @relation("TeacherCosts")
  centerExpenses        CenterExpense[]
  notificationsReceived Notification[]   @relation("NotificationRecipient")
  enrollments           Enrollment[]
  teacherSubjects       TeacherSubject[]

  @@unique([centerId, email], map: "users_center_id_email_key")
  @@unique([centerId, cin], map: "users_center_id_cin_key")
  @@index([centerId, role], map: "users_center_id_role_idx")
  @@index([centerId, isActive], map: "users_center_id_is_active_idx")
  @@map("users")
}

model Subject {
  id              String           @id @default(uuid()) @db.Uuid
  centerId        String           @map("center_id") @db.Uuid
  name            String           @db.VarChar(140)
  description     String           @db.Text
  center          Center           @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "subjects_center_id_fkey")
  courseSessions  CourseSession[]
  teacherSubjects TeacherSubject[]

  @@unique([centerId, name], map: "subjects_center_id_name_key")
  @@index([centerId], map: "subjects_center_id_idx")
  @@map("subjects")
}

model TeacherSubject {
  id            String         @id @default(uuid()) @db.Uuid
  teacherId     String         @map("teacher_id") @db.Uuid
  subjectId     String         @map("subject_id") @db.Uuid
  teacher       User           @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "teacher_subjects_teacher_id_fkey")
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "teacher_subjects_subject_id_fkey")
  studentGroups StudentGroup[]

  @@unique([teacherId, subjectId], map: "teacher_subjects_teacher_id_subject_id_key")
  @@index([teacherId], map: "teacher_subjects_teacher_id_idx")
  @@index([subjectId], map: "teacher_subjects_subject_id_idx")
  @@map("teacher_subjects")
}

model StudentGroup {
  id               String          @id @default(uuid()) @db.Uuid
  centerId         String          @map("center_id") @db.Uuid
  teacherSubjectId String          @map("teacher_subject_id") @db.Uuid
  name             String          @db.VarChar(140)
  schoolCycle      SchoolCycle     @map("school_cycle")
  schoolYear       SchoolYear      @map("school_year")
  center           Center          @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "student_groups_center_id_fkey")
  courseSessions   CourseSession[] @relation("GroupSessions")
  payments         Payment[]
  enrollments      Enrollment[]
  teacherSubject   TeacherSubject  @relation(fields: [teacherSubjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "student_groups_teacher_subject_id_fkey")

  @@unique([centerId, name, schoolCycle, schoolYear], map: "student_groups_center_name_cycle_year_key")
  @@index([centerId], map: "student_groups_center_id_idx")
  @@index([teacherSubjectId], map: "student_groups_teacher_subject_id_idx")
  @@map("student_groups")
}

model Enrollment {
  id             String       @id @default(uuid()) @db.Uuid
  studentId      String       @map("student_id") @db.Uuid
  studentGroupId String       @map("student_group_id") @db.Uuid
  enrollmentDate DateTime     @map("enrollment_date") @db.Date
  isActive       Boolean      @default(true) @map("is_active")
  student        User         @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "enrollments_student_id_fkey")
  studentGroup   StudentGroup @relation(fields: [studentGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "enrollments_student_group_id_fkey")

  @@unique([studentId, studentGroupId], map: "enrollments_student_id_student_group_id_key")
  @@index([studentId, isActive], map: "enrollments_student_id_is_active_idx")
  @@index([studentGroupId, isActive], map: "enrollments_student_group_id_is_active_idx")
  @@map("enrollments")
}

model Room {
  id             String          @id @default(uuid()) @db.Uuid
  centerId       String          @map("center_id") @db.Uuid
  floor          Int
  roomName       String          @map("room_name") @db.VarChar(80)
  isAvailable    Boolean         @default(true) @map("is_available")
  center         Center          @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rooms_center_id_fkey")
  courseSessions CourseSession[]

  @@unique([centerId, floor, roomName], map: "rooms_center_id_floor_room_name_key")
  @@index([centerId, isAvailable], map: "rooms_center_id_is_available_idx")
  @@map("rooms")
}

model CourseSession {
  id             String        @id @default(uuid()) @db.Uuid
  centerId       String        @map("center_id") @db.Uuid
  teacherId      String        @map("teacher_id") @db.Uuid
  subjectId      String        @map("subject_id") @db.Uuid
  studentId      String?       @map("student_id") @db.Uuid
  studentGroupId String?       @map("student_group_id") @db.Uuid
  // Business rule: exactly one of `studentId` or `studentGroupId` should be set.
  roomId         String        @map("room_id") @db.Uuid
  day            DayOfWeek
  startTime      DateTime      @map("start_time") @db.Time(6)
  endTime        DateTime      @map("end_time") @db.Time(6)
  status         SessionStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  center         Center        @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "course_sessions_center_id_fkey")
  teacher        User          @relation("TeacherSessions", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "course_sessions_teacher_id_fkey")
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "course_sessions_subject_id_fkey")
  student        User?         @relation("StudentSessions", fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "course_sessions_student_id_fkey")
  studentGroup   StudentGroup? @relation("GroupSessions", fields: [studentGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "course_sessions_student_group_id_fkey")
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "course_sessions_room_id_fkey")
  payments       Payment[]

  @@index([centerId, day], map: "course_sessions_center_id_day_idx")
  @@index([centerId, teacherId, day, startTime, endTime], map: "course_sessions_center_teacher_day_time_idx")
  @@index([centerId, roomId, day, startTime, endTime], map: "course_sessions_center_room_day_time_idx")
  @@index([centerId, studentGroupId, day, startTime, endTime], map: "course_sessions_center_group_day_time_idx")
  @@map("course_sessions")
}

model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  centerId        String         @map("center_id") @db.Uuid
  studentId       String         @map("student_id") @db.Uuid
  teacherId       String         @map("teacher_id") @db.Uuid
  studentGroupId  String?        @map("student_group_id") @db.Uuid
  courseSessionId String?        @map("course_session_id") @db.Uuid
  amount          Decimal        @db.Decimal(12, 2)
  // Business rule: validate against status in service/migration SQL CHECKs.
  // PAID => rest = 0, PARTIALLY_PAID => rest > 0, UNPAID => rest = amount.
  rest            Decimal        @db.Decimal(12, 2)
  paymentDate     DateTime       @default(now()) @map("payment_date") @db.Timestamptz(6)
  method          PaymentMethod  @default(CASH)
  status          PaymentStatus
  receiptUrl      String?        @map("receipt_url") @db.Text
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  center          Center         @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "payments_center_id_fkey")
  student         User           @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "payments_student_id_fkey")
  teacher         User           @relation("TeacherPayments", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "payments_teacher_id_fkey")
  studentGroup    StudentGroup?  @relation(fields: [studentGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "payments_student_group_id_fkey")
  courseSession   CourseSession? @relation(fields: [courseSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "payments_course_session_id_fkey")

  @@index([centerId, paymentDate], map: "payments_center_id_payment_date_idx")
  @@index([centerId, status, paymentDate], map: "payments_center_status_payment_date_idx")
  @@index([studentId, paymentDate], map: "payments_student_id_payment_date_idx")
  @@index([teacherId, paymentDate], map: "payments_teacher_id_payment_date_idx")
  @@index([studentGroupId], map: "payments_student_group_id_idx")
  @@index([courseSessionId], map: "payments_course_session_id_idx")
  @@map("payments")
}

model CenterCost {
  id            String         @id @default(uuid()) @db.Uuid
  centerId      String         @map("center_id") @db.Uuid
  teacherId     String?        @map("teacher_id") @db.Uuid
  name          String         @db.VarChar(140)
  deductionType DeductionType  @map("deduction_type")
  scope         DeductionScope
  value         Decimal        @db.Decimal(12, 4)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  center        Center         @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "center_costs_center_id_fkey")
  // Business rule: teacherId NULL => GLOBAL, teacherId set => PER_TEACHER.
  teacher       User?          @relation("TeacherCosts", fields: [teacherId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "center_costs_teacher_id_fkey")

  @@index([centerId, isActive], map: "center_costs_center_id_is_active_idx")
  @@index([centerId, scope, isActive], map: "center_costs_center_scope_is_active_idx")
  @@index([teacherId], map: "center_costs_teacher_id_idx")
  @@map("center_costs")
}

model CenterExpense {
  id          String   @id @default(uuid()) @db.Uuid
  centerId    String   @map("center_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  description String   @db.Text
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "center_expenses_center_id_fkey")
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "center_expenses_user_id_fkey")

  @@index([centerId, date], map: "center_expenses_center_id_date_idx")
  @@index([userId, date], map: "center_expenses_user_id_date_idx")
  @@map("center_expenses")
}

model RolePermission {
  id         String           @id @default(uuid()) @db.Uuid
  centerId   String           @map("center_id") @db.Uuid
  role       UserRole
  permission PermissionAction
  isGranted  Boolean          @default(false) @map("is_granted")
  center     Center           @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "role_permissions_center_id_fkey")

  @@unique([centerId, role, permission], map: "role_permissions_center_role_permission_key")
  @@index([centerId, role], map: "role_permissions_center_id_role_idx")
  @@index([centerId, permission], map: "role_permissions_center_id_permission_idx")
  @@map("role_permissions")
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  centerId       String             @map("center_id") @db.Uuid
  recipientId    String             @map("recipient_id") @db.Uuid
  type           NotificationType
  recipientPhone String             @map("recipient_phone") @db.VarChar(32)
  message        String             @db.Text
  status         NotificationStatus @default(PENDING)
  scheduledAt    DateTime           @map("scheduled_at") @db.Timestamptz(6)
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  center         Center             @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "notifications_center_id_fkey")
  recipient      User               @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "notifications_recipient_id_fkey")

  @@index([centerId, status, scheduledAt], map: "notifications_center_status_scheduled_idx")
  @@index([recipientId, status, scheduledAt], map: "notifications_recipient_status_scheduled_idx")
  @@index([centerId, type, createdAt], map: "notifications_center_type_created_idx")
  @@map("notifications")
}
