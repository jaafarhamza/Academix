// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SECRETARY
  TEACHER
  STUDENT
}

enum SchoolCycle {
  PRIMARY
  COLLEGE
  LYCEE
}

enum SchoolYear {
  FIRST_YEAR  @map("1ER")
  SECOND_YEAR @map("2EME")
  THIRD_YEAR  @map("3EME")
  FOURTH_YEAR @map("4EME")
  FIFTH_YEAR  @map("5EME")
  SIXTH_YEAR  @map("6EME")
}

model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique(map: "super_admins_email_key") @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phone        String   @db.VarChar(32)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  centers      Center[]

  @@index([isActive], map: "super_admins_is_active_idx")
  @@map("super_admins")
}

model Center {
  id           String     @id @default(uuid()) @db.Uuid
  superAdminId String     @map("super_admin_id") @db.Uuid
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  centerName   String     @map("center_name") @db.VarChar(140)
  email        String     @unique(map: "centers_email_key") @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  phone        String     @db.VarChar(32)
  subdomain    String     @unique(map: "centers_subdomain_key") @db.VarChar(63)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "centers_super_admin_id_fkey")
  users        User[]

  @@index([superAdminId], map: "centers_super_admin_id_idx")
  @@index([isActive], map: "centers_is_active_idx")
  @@map("centers")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  centerId        String       @map("center_id") @db.Uuid
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String       @map("last_name") @db.VarChar(100)
  email           String       @db.VarChar(320)
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  phone           String       @db.VarChar(32)
  role            UserRole
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  cin             String?      @db.VarChar(32)
  parentPhone     String?      @map("parent_phone") @db.VarChar(32)
  schoolName      String?      @map("school_name") @db.VarChar(140)
  schoolCycle     SchoolCycle? @map("school_cycle")
  schoolYear      SchoolYear?  @map("school_year")
  hourlyRate      Decimal?     @map("hourly_rate") @db.Decimal(10, 2)
  maxHoursPerWeek Decimal?     @map("max_hours_per_week") @db.Decimal(5, 2)
  center          Center       @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "users_center_id_fkey")

  @@unique([centerId, email], map: "users_center_id_email_key")
  @@unique([centerId, cin], map: "users_center_id_cin_key")
  @@index([centerId, role], map: "users_center_id_role_idx")
  @@index([centerId, isActive], map: "users_center_id_is_active_idx")
  @@map("users")
}
