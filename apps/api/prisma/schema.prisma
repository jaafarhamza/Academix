// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  email        String   @unique(map: "super_admins_email_key") @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phone        String   @db.VarChar(32)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  centers      Center[]

  @@index([isActive], map: "super_admins_is_active_idx")
  @@map("super_admins")
}

model Center {
  id           String     @id @default(uuid()) @db.Uuid
  superAdminId String     @map("super_admin_id") @db.Uuid
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  centerName   String     @map("center_name") @db.VarChar(140)
  email        String     @unique(map: "centers_email_key") @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  phone        String     @db.VarChar(32)
  subdomain    String     @unique(map: "centers_subdomain_key") @db.VarChar(63)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "centers_super_admin_id_fkey")

  @@index([superAdminId], map: "centers_super_admin_id_idx")
  @@index([isActive], map: "centers_is_active_idx")
  @@map("centers")
}
